---
import Page from '../../layouts/Page.astro';
---
<Page
  title="My Kitchen"
  description="Your saved AI prompt recipes — your personal collection, stored in your browser."
>
  <section class="page-hero container">
    <h1><span class="h1-emoji">🍽️</span> My Kitchen</h1>
    <p>Your saved recipes — stored right here in your browser. No account needed.</p>
  </section>

  <div class="container my-kitchen-layout">
    <div id="favorites-grid" class="card-grid" hidden>
      <!-- Populated by JS -->
    </div>

    <div id="empty-state" class="empty-state">
      <span class="empty-icon">🤍</span>
      <p>You haven't saved any recipes yet.</p>
      <a href="/prompts/" class="filter-pill active" style="display:inline-block;text-decoration:none;">
        Browse Recipes →
      </a>
    </div>
  </div>
</Page>

<style>
.my-kitchen-layout {
  padding-bottom: var(--s20);
  min-height: 40vh;
}
</style>

<script>
import { getFavorites, saveFavorites, type FavoriteItem } from '../../utils/favorites';
import { escapeHTML } from '../../utils/escapeHTML';

function renderFavorites() {
  const favs = getFavorites();
  const keys = Object.keys(favs);
  const grid = document.getElementById('favorites-grid')!;
  const empty = document.getElementById('empty-state')!;

  if (keys.length === 0) {
    grid.hidden = true;
    empty.hidden = false;
    return;
  }

  grid.hidden = false;
  empty.hidden = true;
  grid.innerHTML = '';

  keys.forEach(id => {
    const fav = favs[id];
    const card = document.createElement('div');
    card.className = 'recipe-card';
    card.style.position = 'relative';

    const meta = document.createElement('div');
    meta.className = 'recipe-card-meta';
    const category = document.createElement('span');
    category.className = 'recipe-card-category';
    category.textContent = fav.category || '';
    meta.appendChild(category);

    const titleH3 = document.createElement('h3');
    const titleA = document.createElement('a');
    titleA.href = fav.url || '';
    titleA.style.color = 'inherit';
    titleA.style.textDecoration = 'none';
    titleA.textContent = fav.title || '';
    titleH3.appendChild(titleA);

    const footer = document.createElement('div');
    footer.className = 'recipe-card-footer';
    const readA = document.createElement('a');
    readA.href = fav.url || '';
    readA.className = 'recipe-card-read';
    readA.textContent = 'Read recipe →';
    const removeBtn = document.createElement('button');
    removeBtn.className = 'heart-btn remove-btn';
    removeBtn.setAttribute('data-id', id);
    removeBtn.setAttribute('aria-label', 'Remove from saved');
    removeBtn.textContent = '❤️';
    footer.appendChild(readA);
    footer.appendChild(removeBtn);

    card.appendChild(meta);
    card.appendChild(titleH3);
    card.appendChild(footer);
    removeBtn.addEventListener('click', () => {
      const favs = getFavorites();
      delete favs[id];
      saveFavorites(favs);
      card.remove();
      if (Object.keys(getFavorites()).length === 0) {
        grid.hidden = true;
        empty.hidden = false;
      }
    });

    grid.appendChild(card);
  });
}

renderFavorites();
</script>
